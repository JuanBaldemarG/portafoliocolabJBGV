        "}\n",
        "resultados_cv = cross_validate(\n",
        "    modelo_bosque, X, costo, cv=cv, scoring=scoring, n_jobs=-1,\n",
        ")\n",
        "\n",
        "resumen_cv = pd.DataFrame({\n",
        "    'métrica': ['MAE', 'RMSE', 'R2'],\n",
        "    'promedio': [\n",
        "        -resultados_cv['test_MAE'].mean(),\n",
